{
  "name": "benchline",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite --config vite.client.config.ts\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --config vite.client.config.ts",
    "build": "tsc -b && vite build --config vite.client.config.ts",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,css,md,yml,yaml}\"",
    "test": "vitest run && python3 -m unittest discover -s ml -p 'test_*.py'",
    "test:watch": "vitest",
    "benchmark": "python3 ml/backtest.py --output evidence/backtest.json",
    "loadtest": "tsx scripts/load-test.ts",
    "validate:evidence": "tsx scripts/validate-evidence.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test && npm run validate:evidence",
    "sites:build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "lucide-react": "^0.544.0",
    "next": "^16.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "^19.2.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vinext": "^0.0.50",
    "vite": "^8.0.13",
    "vitest": "^4.0.17",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=20"
  }
}
